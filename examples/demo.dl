// DanLang — демонстрационная программа
// Язык: DanLang (if/else + while, ввод output/input)
// Компиляция: danlangc examples/demo.dl

// ── Вычисление факториала ──────────────────────────────────────────────────
int n = 5;
int fact = 1;
int i = 1;

while (i <= n) {
    fact = fact * i;
    i = i + 1;
}
output(fact);        // ожидается: 120

// ── Оператор if / else ────────────────────────────────────────────────────
int x = 10;
int y = 20;

if (x < y)
    output(x);       // x меньше — выводим x (10)
else
    output(y);

// ── Подсчёт суммы 1..5 циклом while ───────────────────────────────────────
int sum = 0;
int k = 1;
while (k <= 5) {
    sum = sum + k;
    k = k + 1;
}
output(sum);         // ожидается: 15

// ── Намеренные ошибки для тестирования обработчика ────────────────────────

// Ошибка 1 (лексическая): одиночный & вместо &&
if (x > 0 & y > 0)
    output(1);

// Ошибка 2 (семантическая): использование необъявленной переменной z
output(z);

// Ошибка 3 (семантическая): повторное объявление переменной n
int n = 99;
